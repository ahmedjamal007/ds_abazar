<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Dawaii.Core</RootNamespace>
    <AssemblyName>Dawaii.Core</AssemblyName>
    <Deterministic>true</Deterministic>
    <Version>1.4.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NeutralLanguage>ar</NeutralLanguage>
  </PropertyGroup>

  <!-- DPAPI, for the machine-scoped secrets in MachineSecret: the MySQL password and the Telegram
       bot token. On .NET Framework it is a GAC assembly; on modern .NET it is a package. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local single-file backend (default, zero setup). Bundles the native SQLite engine. -->
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <!-- Shared-server backend for network mode (V1.2 req 6): MySQL running as a Windows service. -->
    <PackageReference Include="MySql.Data" Version="8.0.33" />
    <!-- Pure-managed QR generation (PngByteQRCode needs no System.Drawing / network) for offline label printing -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <!-- Embed the SQL scripts so the app/initializer can create the schema and seed data
       without depending on any file being present on disk. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\db\schema.sql" Link="Sql\schema.sql" />
    <EmbeddedResource Include="..\..\db\seed.sql" Link="Sql\seed.sql" />
    <EmbeddedResource Include="..\..\db\seed.demo.sql" Link="Sql\seed.demo.sql" />
    <EmbeddedResource Include="..\..\db\schema.mysql.sql" Link="Sql\schema.mysql.sql" />
    <EmbeddedResource Include="..\..\db\seed.mysql.sql" Link="Sql\seed.mysql.sql" />
    <EmbeddedResource Include="..\..\db\seed.demo.mysql.sql" Link="Sql\seed.demo.mysql.sql" />
    <!-- The Telegram bot's own tables, in a SEPARATE database from the pharmacy's (V2.6). -->
    <EmbeddedResource Include="..\..\db\bot.schema.sql" Link="Sql\bot.schema.sql" />
  </ItemGroup>

</Project>
