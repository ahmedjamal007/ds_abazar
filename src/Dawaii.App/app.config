<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <!--
    No database configuration needed: Dawaii uses a local SQLite file created automatically at
    %ProgramData%\Dawaii\dawaii.db. To relocate it, put "database=<full path>" in a dawaii.ini
    file next to Dawaii.exe.
  -->
</configuration>
